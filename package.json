{
  "name": "contextify-ai",
  "author": "Althaf Pattan",
  "version": "0.3.0",
  "description": "AI-powered .context.md files, auto-generated at every commit. Contextify your codebase.",
  "main": "src/index.js",
  "bin": {
    "contextify": "./bin/contextify.js",
    "contextify-ai": "./bin/contextify.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "init": "node bin/contextify.js init",
    "generate": "node bin/contextify.js generate",
    "generate:dry-run": "node bin/contextify.js generate --dry-run",
    "generate:force": "node bin/contextify.js generate --force",
    "audit": "node bin/contextify.js audit",
    "audit:stale": "node bin/contextify.js audit --stale"
  },
  "keywords": [
    "ai",
    "context",
    "documentation",
    "git-hooks",
    "pre-commit",
    "llm",
    "claude",
    "openai",
    "gemini",
    "ollama",
    "github-models",
    "developer-tools",
    "code-context",
    "react",
    "angular",
    "vue",
    "ast",
    "smart-diff",
    "context-engineering"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cosmiconfig": "^8.3.6",
    "glob": "^10.3.10",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "simple-git": "^3.22.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlthafPattan/contextify-ai.git"
  },
  "bugs": {
    "url": "https://github.com/AlthafPattan/contextify-ai/issues"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ]
}
